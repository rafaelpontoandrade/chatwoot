# === Chatwoot Enterprise — PRODUÇÃO (crm.rpweb.site) ===
# NÃO comitar. Segredos abaixo são únicos desta instalação.
# Use sempre com: docker compose --env-file .env.production -f docker-compose.prod.yaml ...

SECRET_KEY_BASE=1158795b7374a4be0af163bab421b055c4de4e1306756699872ceb33596314f11fd5676441b5bdcc8996e060479c2f1bd4215afbc2b766240dd34ef8cc69980d

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# ---- Domínio / URLs ----
FRONTEND_URL=https://crm.rpweb.site
# Força links/redirects em https (atrás do Caddy)
FORCE_SSL=true
# Origem confiável p/ WebSocket/CORS já vem de FRONTEND_URL

# ---- Cadastro de contas ----
# Comece com 'true' SÓ para criar seu 1º admin pela tela de cadastro.
# Depois troque para 'false' e rode `up -d` de novo (ver guia, passo 5).
ENABLE_ACCOUNT_SIGNUP=false

DEFAULT_LOCALE=pt_BR

# Instalação self-hosted (não-cloud) — necessário p/ o plano enterprise destravar premium
DEPLOYMENT_ENV=docker

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=34b1a444f12cdf4a7397a7773d4334a340d636202b52ca8d
POSTGRES_DATABASE=chatwoot

# ---- Redis ----
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=7529be538591e5e9f866c2c93a540b17de6413b21bd502b3

# ---- Logs ----
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# ---- SMTP (OBRIGATÓRIO em produção: convites, reset de senha, notificações) ----
# Preencha com os dados do seu provedor (ex.: SendGrid, Mailgun, Amazon SES, SMTP próprio).
MAILER_SENDER_EMAIL=Chatwoot <no-reply@rpweb.site>
SMTP_DOMAIN=rpweb.site
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_OPENSSL_VERIFY_MODE=peer

# ---- Active Storage (uploads) ----
# Padrão: disco local (volume storage_data). Para S3, descomente e preencha:
# ACTIVE_STORAGE_SERVICE=amazon
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
